# Copier en .env.local pour le développement (jamais de vraie valeur dans le dépôt).
DATABASE_URL=postgres://postgres@localhost:5433/garrym
# Secret de chiffrement (32 caractères aléatoires au moins) : protège les secrets de double authentification en base.
APP_SECRET=
# Adresse publique de l'espace (liens des emails d'invitation et de réinitialisation).
APP_URL=http://localhost:3100
# outbox (développement : emails enregistrés en base, visibles sur /dev/emails) ou brevo (production).
EMAIL_DRIVER=outbox
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=GM Sport et Nutrition
